{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-check.sh\"", "timeout": 5 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-secrets.sh\"", "timeout": 5 }]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-attribution.sh\"", "timeout": 5 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-bypass.sh\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-web.sh\"", "timeout": 5 }]
      }
    ]
  }
}
